# 서버 접속 포트 (개발 `npm run dev`, exe 옆 `.env`, `npm run preview` 공통)
PORT=3009

# 바인딩 주소 (0.0.0.0 = 외부·LAN 접속 허용, exe 기본 localhost)
HOSTNAME=0.0.0.0
# LAN 사용 시 exe 폴더에서 (PowerShell, 관리자):
#   cd "exe폴더경로"
#   Start-Process -FilePath ".\allow-firewall-inbound.bat" -Verb RunAs

# Vite dev 전용 — 허용 Host (쉼표 구분, * = 모두 허용). exe 빌드에는 포함되지 않음.
ALLOWED_HOSTS=*

# 데이터 저장 폴더 (기본: exe/프로젝트 폴더/data). 상대·절대 경로 모두 가능
# DATA_ROOT=data
# DATA_ROOT=D:/USB/nas4usb-data

# 관리자 로그인 (상단 로그인 폼)
ADMIN_ID=admin
ADMIN_PW=admin1234
