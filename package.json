{
  "name": "educowork",
  "version": "0.1.0",
  "description": "Offline LAN NAS & real-time collaborative HWPX editor",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "electron .",
    "build:rhwp-studio": "node scripts/build-rhwp-studio.mjs",
    "build:wb4s-editor": "node scripts/build-wb4s-editor.mjs",
    "sync:wb4s-src": "node scripts/sync-wb4s-src.mjs",
    "build": "npm run build:rhwp-studio && npm run build:wb4s-editor && vite build",
    "start": "npm run build && electron .",
    "preview": "vite preview --port 3008 --strictPort"
  },
  "keywords": [
    "electron",
    "nas",
    "crdt",
    "yjs",
    "hwpx"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "@xmldom/xmldom": "^0.9.10",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^33.2.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  },
  "dependencies": {
    "@rhwp/core": "^0.7.17",
    "@rhwp/editor": "^0.7.17",
    "jszip": "^3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0",
    "y-websocket": "^2.1.0",
    "yjs": "^13.6.21"
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
