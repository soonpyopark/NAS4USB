{
  "name": "nas4usb",
  "version": "1.0.4",
  "description": "Offline LAN NAS & real-time collaborative HWPX editor",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "npm run prepare:icons && npm run prepare:wb4s-src && electron .",
    "dev:stop": "node scripts/dev-process.mjs stop",
    "dev:restart": "node scripts/dev-process.mjs restart",
    "prepare:icons": "node scripts/prepare-app-icon.mjs",
    "prepare:wb4s-deps": "node scripts/prepare-wb4s-src.mjs",
    "prepare:wb4s-src": "node scripts/prepare-wb4s-src.mjs",
    "build:rhwp-studio": "node scripts/build-rhwp-studio.mjs",
    "build:wb4s-editor": "node scripts/build-wb4s-editor.mjs",
    "sync:wb4s-upstream": "node scripts/sync-wb4s-upstream.mjs",
    "sync:wb4s-src": "node scripts/sync-wb4s-upstream.mjs",
    "build": "npm run prepare:icons && npm run build:rhwp-studio && npm run build:wb4s-editor && npm run prepare:wb4s-src && vite build",
    "build:dist:exe": "npm run prepare:icons && node scripts/build-dist-exe.mjs",
    "build:dist:mac": "npm run prepare:icons && node scripts/build-dist-mac.mjs",
    "build:msi": "npm run prepare:icons && node scripts/build-msi.mjs",
    "build:release": "node scripts/build-release.mjs",
    "sync-version": "node scripts/sync-version.mjs",
    "update:all": "node scripts/update-all.mjs",
    "build:update_all": "update_all.bat _inner build",
    "start": "npm run build && electron .",
    "preview": "vite preview --port 3009 --strictPort"
  },
  "keywords": [
    "electron",
    "nas",
    "crdt",
    "yjs",
    "hwpx"
  ],
  "author": "Daniel Park",
  "license": "MIT",
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "@xmldom/xmldom": "^0.9.10",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.4.49",
    "rcedit": "^5.0.2",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  },
  "dependencies": {
    "@fortune-sheet/react": "^1.0.4",
    "@rhwp/core": "^0.8.2",
    "@rhwp/editor": "^0.8.2",
    "@tiptap/core": "3.29.2",
    "@tiptap/extension-bubble-menu": "3.29.2",
    "@tiptap/extension-character-count": "^3.29.2",
    "@tiptap/extension-code-block-lowlight": "^3.29.2",
    "@tiptap/extension-collaboration": "3.29.2",
    "@tiptap/extension-collaboration-caret": "3.29.2",
    "@tiptap/extension-color": "^3.29.2",
    "@tiptap/extension-details": "^3.29.2",
    "@tiptap/extension-drag-handle": "^3.29.2",
    "@tiptap/extension-drag-handle-react": "^3.29.2",
    "@tiptap/extension-emoji": "^3.29.2",
    "@tiptap/extension-floating-menu": "^3.29.2",
    "@tiptap/extension-focus": "^3.29.2",
    "@tiptap/extension-highlight": "3.29.2",
    "@tiptap/extension-image": "3.29.2",
    "@tiptap/extension-invisible-characters": "^3.29.2",
    "@tiptap/extension-link": "3.29.2",
    "@tiptap/extension-list-keymap": "^3.29.2",
    "@tiptap/extension-mathematics": "^3.29.2",
    "@tiptap/extension-mention": "^3.29.2",
    "@tiptap/extension-node-range": "^3.29.2",
    "@tiptap/extension-placeholder": "3.29.2",
    "@tiptap/extension-subscript": "^3.29.2",
    "@tiptap/extension-superscript": "^3.29.2",
    "@tiptap/extension-table": "3.29.2",
    "@tiptap/extension-table-of-contents": "^3.29.2",
    "@tiptap/extension-task-item": "3.29.2",
    "@tiptap/extension-task-list": "3.29.2",
    "@tiptap/extension-text-align": "3.29.2",
    "@tiptap/extension-text-style": "^3.29.2",
    "@tiptap/extension-typography": "^3.29.2",
    "@tiptap/extension-underline": "3.29.2",
    "@tiptap/extension-unique-id": "^3.29.2",
    "@tiptap/extension-youtube": "^3.29.2",
    "@tiptap/markdown": "^3.29.2",
    "@tiptap/pm": "3.29.2",
    "@tiptap/react": "3.29.2",
    "@tiptap/starter-kit": "3.29.2",
    "@tiptap/suggestion": "3.29.2",
    "@tiptap/y-tiptap": "3.0.7",
    "jszip": "^3.10.1",
    "katex": "^0.16.47",
    "lowlight": "^3.3.0",
    "prosemirror-tables": "^1.8.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tippy.js": "^6.3.7",
    "ws": "^8.18.0",
    "xlsx": "^0.18.5",
    "xlsx-js-style": "^1.2.0",
    "y-prosemirror": "^1.3.7",
    "y-websocket": "^2.1.0",
    "yjs": "^13.6.21"
  },
  "overrides": {
    "@tiptap/core": "3.29.2",
    "@tiptap/pm": "3.29.2"
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "build": {
    "appId": "com.nas4usb.app",
    "productName": "NAS4USB",
    "icon": "build/icon-512.png",
    "directories": {
      "output": ".dist-build"
    },
    "files": [
      "main.js",
      "preload.cjs",
      "electron/**/*",
      "shared/**/*",
      "scripts/wb4s-engine.mjs",
      "scripts/wb4s-upstream.mjs",
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "extraFiles": [
      {
        "from": "lib",
        "to": "lib",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "public/wb4s-editor",
        "to": "public/wb4s-editor",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".env.example",
        "to": ".env.example"
      }
    ],
    "extraResources": [
      {
        "from": "build/icon-512.png",
        "to": "app-icon.png"
      },
      {
        "from": "build/icon.ico",
        "to": "app-icon.ico"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dir"
        }
      ]
    }
  }
}
