{
  "name": "nas4usb",
  "version": "1.0.9",
  "description": "Offline LAN NAS & real-time collaborative HWPX editor",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "npm run prepare:icons && npm run prepare:pdfjs && npm run prepare:wb4s-src && electron .",
    "dev:stop": "node scripts/dev-process.mjs stop",
    "dev:restart": "node scripts/dev-process.mjs restart",
    "prepare:icons": "node scripts/prepare-app-icon.mjs",
    "prepare:pdfjs": "node scripts/prepare-pdfjs-assets.mjs",
    "prepare:wb4s-deps": "node scripts/prepare-wb4s-src.mjs",
    "prepare:wb4s-src": "node scripts/prepare-wb4s-src.mjs",
    "build:rhwp-studio": "node scripts/build-rhwp-studio.mjs",
    "build:wb4s-editor": "node scripts/build-wb4s-editor.mjs",
    "sync:wb4s-upstream": "node scripts/sync-wb4s-upstream.mjs",
    "sync:wb4s-src": "node scripts/sync-wb4s-upstream.mjs",
    "build": "npm run prepare:icons && npm run prepare:pdfjs && npm run build:rhwp-studio && npm run build:wb4s-editor && npm run prepare:wb4s-src && vite build",
    "build:dist:exe": "npm run prepare:icons && node scripts/build-dist-exe.mjs",
    "build:dist:mac": "npm run prepare:icons && node scripts/build-dist-mac.mjs",
    "build:dist:mac:update": "npm run prepare:icons && node scripts/build-dist-mac.mjs --update",
    "build:msi": "npm run prepare:icons && node scripts/build-msi.mjs",
    "build:release": "node scripts/build-release.mjs",
    "sync-version": "node scripts/sync-version.mjs",
    "update:all": "node scripts/update-all.mjs",
    "build:update_all": "update_all.bat _inner build && npm run build:release",
    "build:update_all:mac": "node scripts/update-all.mjs && npm run build:dist:mac",
    "start": "npm run build && electron .",
    "preview": "vite preview --port 3009 --strictPort"
  },
  "keywords": [
    "electron",
    "nas",
    "crdt",
    "yjs",
    "hwpx"
  ],
  "author": "Daniel Park",
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@xmldom/xmldom": "^0.9.12",
    "autoprefixer": "^10.5.5",
    "concurrently": "^10.0.5",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.28",
    "rcedit": "^5.0.2",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "wait-on": "^9.1.0"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.11",
    "@fortune-sheet/react": "^1.0.4",
    "@rhwp/core": "^0.8.6",
    "@rhwp/editor": "^0.8.6",
    "@tedyang2003/onenote-converter-wasm": "^1.0.1",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-bubble-menu": "^3.31.3",
    "@tiptap/extension-character-count": "^3.31.3",
    "@tiptap/extension-code-block-lowlight": "^3.31.3",
    "@tiptap/extension-collaboration": "^3.31.3",
    "@tiptap/extension-collaboration-caret": "^3.31.3",
    "@tiptap/extension-color": "^3.31.3",
    "@tiptap/extension-details": "^3.31.3",
    "@tiptap/extension-drag-handle": "^3.31.3",
    "@tiptap/extension-drag-handle-react": "^3.31.3",
    "@tiptap/extension-emoji": "^3.31.3",
    "@tiptap/extension-floating-menu": "^3.31.3",
    "@tiptap/extension-focus": "^3.31.3",
    "@tiptap/extension-highlight": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-invisible-characters": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-list-keymap": "^3.31.3",
    "@tiptap/extension-mathematics": "^3.31.3",
    "@tiptap/extension-mention": "^3.31.3",
    "@tiptap/extension-node-range": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-subscript": "^3.31.3",
    "@tiptap/extension-superscript": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-table-of-contents": "^3.31.3",
    "@tiptap/extension-task-item": "^3.31.3",
    "@tiptap/extension-task-list": "^3.31.3",
    "@tiptap/extension-text-align": "^3.31.3",
    "@tiptap/extension-text-style": "^3.31.3",
    "@tiptap/extension-typography": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/extension-unique-id": "^3.31.3",
    "@tiptap/extension-youtube": "^3.31.3",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/suggestion": "^3.31.3",
    "@tiptap/y-tiptap": "^3.0.9",
    "7zip-min": "^3.0.1",
    "codemirror": "^6.0.2",
    "epubjs": "^0.3.93",
    "hls.js": "^1.7.2",
    "jszip": "^3.10.2",
    "katex": "^0.18.7",
    "kordoc": "^4.13.1",
    "lowlight": "^3.3.0",
    "node-forge": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^6.3.289",
    "prosemirror-tables": "^1.8.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sql.js": "^1.14.2",
    "tippy.js": "^6.3.7",
    "video.js": "^8.24.0",
    "word-extractor": "^1.0.4",
    "ws": "^8.21.3",
    "xlsx": "^0.18.5",
    "xlsx-js-style": "^1.2.0",
    "y-prosemirror": "^1.3.7",
    "y-websocket": "2.1.0",
    "yjs": "^13.6.32"
  },
  "overrides": {
    "@tiptap/core": "$@tiptap/core",
    "@tiptap/pm": "$@tiptap/pm"
  },
  "allowScripts": {
    "electron@44.3.0": true
  },
  "build": {
    "appId": "com.nas4usb.app",
    "productName": "NAS4USB",
    "icon": "build/icon-512.png",
    "directories": {
      "output": ".dist-build"
    },
    "files": [
      "main.js",
      "preload.cjs",
      "electron/**/*",
      "shared/**/*",
      "scripts/wb4s-engine.mjs",
      "scripts/wb4s-upstream.mjs",
      "dist/**/*",
      "seed/data/**/*",
      "lib/cores-manifest.json",
      "package.json",
      "!**/node_modules/onnxruntime-node/**",
      "!**/node_modules/@huggingface/transformers/**",
      "!**/node_modules/@hyzyla/pdfium/**"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/7zip-bin/**",
      "**/node_modules/7zip-min/**",
      "**/node_modules/7zip-min/node_modules/7zip-bin/**",
      "**/node_modules/@tedyang2003/onenote-converter-wasm/**"
    ],
    "extraFiles": [
      {
        "from": "lib",
        "to": "lib",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "public/wb4s-editor",
        "to": "public/wb4s-editor",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".env.example",
        "to": ".env.example"
      }
    ],
    "extraResources": [
      {
        "from": "build/icon-512.png",
        "to": "app-icon.png"
      },
      {
        "from": "build/icon.ico",
        "to": "app-icon.ico"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "node_modules/7zip-bin/win/x64/7za.exe",
        "to": "bin/7za.exe"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dir"
        }
      ]
    }
  }
}
