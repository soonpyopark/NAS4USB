{
  "name": "educowork",
  "version": "1.0.1",
  "description": "Offline LAN NAS & real-time collaborative HWPX editor",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "npm run prepare:wb4s-src && electron .",
    "dev:stop": "node scripts/dev-process.mjs stop",
    "dev:restart": "node scripts/dev-process.mjs restart",
    "prepare:icons": "node scripts/prepare-app-icon.mjs",
    "prepare:wb4s-deps": "node scripts/prepare-wb4s-src.mjs",
    "prepare:wb4s-src": "node scripts/prepare-wb4s-src.mjs",
    "build:rhwp-studio": "node scripts/build-rhwp-studio.mjs",
    "build:wb4s-editor": "node scripts/build-wb4s-editor.mjs",
    "sync:wb4s-upstream": "node scripts/sync-wb4s-upstream.mjs",
    "sync:wb4s-src": "node scripts/sync-wb4s-upstream.mjs",
    "build": "npm run prepare:icons && npm run build:rhwp-studio && npm run build:wb4s-editor && npm run prepare:wb4s-src && vite build",
    "build:dist:exe": "npm run prepare:icons && node scripts/build-dist-exe.mjs",
    "build:dist:mac": "npm run prepare:icons && node scripts/build-dist-mac.mjs",
    "start": "npm run build && electron .",
    "preview": "vite preview --port 3008 --strictPort"
  },
  "keywords": [
    "electron",
    "nas",
    "crdt",
    "yjs",
    "hwpx"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "@xmldom/xmldom": "^0.9.10",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "rcedit": "^5.0.2",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  },
  "dependencies": {
    "@fortune-sheet/react": "^1.0.4",
    "@rhwp/core": "^0.7.17",
    "@rhwp/editor": "^0.7.17",
    "jszip": "^3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0",
    "xlsx": "^0.18.5",
    "xlsx-js-style": "^1.2.0",
    "y-websocket": "^2.1.0",
    "yjs": "^13.6.21"
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "build": {
    "appId": "com.educowork.app",
    "productName": "NAS4USB",
    "icon": "build/icon.png",
    "directories": {
      "output": ".dist-build"
    },
    "files": [
      "main.js",
      "preload.cjs",
      "electron/**/*",
      "shared/**/*",
      "scripts/wb4s-engine.mjs",
      "scripts/wb4s-upstream.mjs",
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "extraFiles": [
      {
        "from": "lib",
        "to": "lib",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "public/wb4s-editor",
        "to": "public/wb4s-editor",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".env.example",
        "to": ".env.example"
      }
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "app-icon.png"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dir"
        }
      ]
    }
  }
}
